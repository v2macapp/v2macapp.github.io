---
import { renderNotes } from '../../markdown';
import Page from '../../layouts/Page.astro';
import { en as t } from '../../strings';
import { releases, type Release } from '../../releases';

export const getStaticPaths = () => releases.map((r) => ({ params: { tag: r.tag_name }, props: { r } }));
const { r } = Astro.props as { r: Release };
const code = await renderNotes(r.body ?? '');
const date = new Date(r.published_at).toLocaleDateString('en-GB', { dateStyle: 'long', timeZone: 'UTC' });
---
<Page title={`${r.name} release notes`} description={`What changed in ${r.name}, released on ${date}.`} ogType="article">
  <header>
    <h1>{r.name}</h1>
    <p class="meta"><time datetime={r.published_at}>{date}</time></p>
  </header>
  <section class="panel notes" set:html={code} />
  <p><a href={r.html_url}>{t.blog.onGithub}</a> · <a href="/blog/">{t.blog.all}</a></p>
</Page>
<style>
  .notes { overflow-wrap: anywhere; }
  .notes :global(h2) { font-size: 22px; margin-top: 18px; }
  .notes :global(h2:first-child) { margin-top: 0; }
</style>
