---
import Page from '../layouts/Page.astro';
import Shield from '../components/Shield.astro';
import { en, NOLEAKER_URL, NOLEAKER_DOWNLOAD_URL } from '../strings';
const t = en.noleakerPage;
const rows = ['ip', 'webrtc', 'timezone', 'language', 'quic', 'dns'] as const;
const software = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'NoLeaker', description: t.description,
  applicationCategory: 'BrowserApplication', operatingSystem: 'Chrome 120+, Firefox 140+',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, downloadUrl: NOLEAKER_DOWNLOAD_URL,
};
---
<Page title={t.title} description={t.description} jsonld={[software]} og="/og/noleaker.jpg" earth>
  <header class="hero">
    <Shield />
    <h1>{t.heading}</h1>
    <p class="lede">{t.lede}</p>
    <div class="actions"><button type="button" class="button primary" id="run" data-again={t.again}>{t.run}</button></div>
    <p class="meta">{t.privacy}</p>
  </header>

  <section class="panel" id="results" hidden aria-live="polite">
    <ul>
      {rows.map((r) => (
        <li data-row={r}><h2>{t.tests[r]}</h2><span class="pill"></span><p></p></li>
      ))}
    </ul>
    <p id="summary"></p>
  </section>

  <section class="panel">
    <h2>{t.what.title}</h2>
    <p>{t.what.lede}</p>
    <div class="grid">{t.what.items.map(([h, p]) => <div><h3>{h}</h3><p>{p}</p></div>)}</div>
    <div class="actions start">
      <a class="button primary" href={NOLEAKER_DOWNLOAD_URL}>{t.what.download}</a>
      <a class="button" href={NOLEAKER_URL}>{t.what.source}</a>
    </div>
    <p class="pair">{t.what.pair}</p>
  </section>
</Page>

<script>
  import { en } from '../strings';
  import { baseline, languageMatches, sourcesDisagree, timezoneMatches, traceIp, usesQuic, webrtcLeaks, type Verdict } from '../leak';
  const t = en.noleakerPage, say = t.says;
  const button = document.querySelector<HTMLButtonElement>('#run')!;
  const results = document.querySelector<HTMLElement>('#results')!;
  const summary = document.querySelector<HTMLElement>('#summary')!;

  function show(row: string, kind: Verdict | 'shown' | 'pending', text = '') {
    const li = results.querySelector(`[data-row="${row}"]`)!;
    const pill = li.querySelector<HTMLElement>('.pill')!;
    pill.dataset.kind = kind;
    pill.textContent = kind === 'pending' ? t.pending : t.verdict[kind];
    li.querySelector('p')!.textContent = text;
  }

  const getJson = async (url: string) => { const r = await fetch(url, { cache: 'no-store' }); if (!r.ok) throw new Error(String(r.status)); return r.json(); };
  const getText = async (url: string) => { const r = await fetch(url, { cache: 'no-store' }); if (!r.ok) throw new Error(String(r.status)); return r.text(); };

  /** The address as a public service sees it. Two services, because free ones rate-limit. */
  async function lookup() {
    try {
      const d = await getJson('https://ipinfo.io/json');
      if (d.ip && d.timezone) return { ip: d.ip, city: d.city, country: d.country, code: d.country, zone: d.timezone };
    } catch {}
    try {
      const d = await getJson('https://ipwho.is/');
      if (d.success) return { ip: d.ip, city: d.city, country: d.country, code: d.country_code, zone: d.timezone?.id };
    } catch {}
    return null;
  }

  /** Every ICE candidate the browser finds in 3 seconds; null when WebRTC is unavailable. */
  async function iceCandidates(): Promise<string[] | null> {
    if (typeof RTCPeerConnection === 'undefined') return null;
    const pc = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.cloudflare.com:3478' }] });
    const found: string[] = [];
    try {
      pc.createDataChannel('leak-test');
      await new Promise<void>(async (done) => {
        const timer = setTimeout(done, 3000);
        pc.onicecandidate = (e) => {
          if (e.candidate) found.push(e.candidate.candidate);
          else { clearTimeout(timer); done(); }
        };
        await pc.setLocalDescription(await pc.createOffer());
      });
      return found;
    } catch {
      return null;
    } finally {
      pc.close();
    }
  }

  async function run() {
    button.disabled = true;
    results.hidden = false;
    summary.textContent = '';
    for (const r of ['ip', 'webrtc', 'timezone', 'language', 'quic']) show(r, 'pending');
    show('dns', 'unknown', say.dns);

    // A second request, because browsers only try HTTP/3 once a site has offered it.
    const trace = await getText('https://one.one.one.one/cdn-cgi/trace').then(() => getText('https://one.one.one.one/cdn-cgi/trace')).catch(() => null);
    const ipInfo = await lookup();
    const ice = await iceCandidates();
    const seen = [ipInfo?.ip, trace && traceIp(trace)];
    const known = baseline(seen);
    const verdicts: Verdict[] = [];
    const judge = (row: string, v: Verdict, text: string) => { verdicts.push(v); show(row, v, text); };

    if (ipInfo) show('ip', 'shown', `${ipInfo.ip} · ${[ipInfo.city, ipInfo.country].filter(Boolean).join(', ')}`);
    else if (known.length) show('ip', 'shown', known[0]);
    else show('ip', 'unknown', say.ipFailed);

    if (ice === null) judge('webrtc', 'ok', say.webrtcBlocked);
    else if (!known.length) judge('webrtc', 'unknown', say.ipFailed);
    else {
      const leaks = webrtcLeaks(ice, known);
      if (leaks.length) judge('webrtc', 'leak', say.webrtcLeak(leaks.join(', ')));
      else judge('webrtc', 'ok', say.webrtcOk);
    }

    const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const ipZone = ipInfo?.zone;
    if (!ipZone) judge('timezone', 'unknown', say.ipFailed);
    else if (timezoneMatches(zone, ipZone)) judge('timezone', 'ok', say.tzOk(zone));
    else judge('timezone', 'leak', say.tzLeak(zone, ipZone));

    const lang = navigator.language;
    if (!ipInfo?.code) judge('language', 'unknown', say.ipFailed);
    else if (languageMatches(lang, ipInfo.code)) judge('language', 'ok', say.langOk(lang));
    else judge('language', 'hint', say.langHint(lang, ipInfo.country));

    if (!trace) judge('quic', 'unknown', say.quicFailed);
    else if (usesQuic(trace) && sourcesDisagree(seen)) judge('quic', 'leak', say.quicLeak);
    else if (usesQuic(trace)) judge('quic', 'hint', say.quicUsed);
    else judge('quic', 'ok', say.quicNone);

    const leaks = verdicts.filter((v) => v === 'leak').length;
    summary.textContent = leaks ? t.summaryLeak(leaks) : t.summaryOk;
    button.disabled = false;
    button.textContent = button.dataset.again!;
  }
  button.addEventListener('click', run);
</script>
<style>
  .hero { text-align: center; }
  .hero .lede { margin-left: auto; }
  .start { justify-content: flex-start; }
  button.button { font-family: inherit; cursor: pointer; }
  button.button:disabled { opacity: 0.6; cursor: progress; }
  #results ul { list-style: none; padding: 0; margin: 0; }
  #results li { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.09); margin: 0; }
  #results h2 { font-size: 17px; margin: 0; letter-spacing: 0; }
  #results li p { grid-column: 1 / -1; margin: 0; overflow-wrap: anywhere; }
  .pill { font-size: 12px; font-weight: 700; padding: 2px 10px; border-radius: 999px; background: rgba(255, 255, 255, 0.1); color: var(--dim); align-self: center; }
  .pill[data-kind='ok'] { background: rgba(48, 209, 88, 0.18); color: var(--green); }
  .pill[data-kind='leak'] { background: rgba(255, 69, 58, 0.2); color: var(--red); }
  .pill[data-kind='hint'] { background: rgba(255, 159, 10, 0.18); color: var(--orange); }
  #summary { color: var(--text); font-weight: 600; margin: 16px 0 0; }
  .pair { font-size: 14px; margin-bottom: 0; }
  .grid { margin-top: 18px; }
</style>
