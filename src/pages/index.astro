---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import { en as t, DOWNLOAD_URL, REPO_URL } from '../strings';
import { PRESETS } from '../scene/presets';
import AppWindow from '../components/AppWindow.astro';
import Lens from '../components/Lens.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark" />
  <title>{t.title}</title>
  <meta name="description" content={t.description} />
  <link rel="canonical" href={Astro.site} />
  <link rel="preload" as="image" href="/poster.jpg" />
</head>
<body>
  <img class="poster" src="/poster.jpg" alt="" aria-hidden="true" />
  <canvas id="stage" aria-hidden="true"></canvas>

  <main>
    <section class="chapter hero">
      <div class="copy">
        <h1>{t.hero.name}</h1>
        <p class="tagline">{t.hero.tagline}</p>
        <p class="lede">{t.hero.lede}</p>
        <div class="actions">
          <a class="button primary" href={DOWNLOAD_URL}>{t.hero.download}</a>
          <a class="button" href={REPO_URL}>{t.hero.source}</a>
        </div>
        <p class="meta">{t.hero.meta}</p>
      </div>
      <span class="scroll" aria-hidden="true">{t.hero.scroll}</span>
    </section>

    <section class="stage app">
      <h2 class="ptitle">{t.app.title}</h2>
      <AppWindow />
    </section>

    <section class="stage see">
      <h2 class="ptitle">{t.see.title}</h2>
      <p class="lede">{t.see.lede}</p>
      <Lens />
    </section>
  </main>

  <footer>
    <div class="graphics" role="group" aria-label={t.footer.graphics}>
      <span>{t.footer.graphics}:</span>
      <button type="button" data-choice="auto">{t.footer.auto}</button>
      {PRESETS.map((p) => <button type="button" data-choice={p}>{t.footer.presets[p]}</button>)}
    </div>
    <p>{t.footer.tracking}</p>
  </footer>
  <div id="fps" hidden></div>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { ScrambleTextPlugin } from 'gsap/ScrambleTextPlugin';
    import { en as t } from '../strings';
    import { savedChoice, saveChoice, reducedMotion, type Choice } from '../scene/presets';
    import type { Progress, Stage } from '../scene/scene';

    gsap.registerPlugin(ScrollTrigger, ScrambleTextPlugin);
    const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector(s) as T;
    const $$ = <T extends Element = HTMLElement>(s: string) => [...document.querySelectorAll<T>(s)];

    // ---- Scroll: one timeline per chapter; the 3D reads `progress`.
    const progress: Progress = { burst: 0, title: 0, out: 0 };
    const scrub = 0.6;

    gsap.to(progress, { burst: 1, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub } });
    gsap.to('.hero .copy, .hero .scroll', { opacity: 0, y: -60, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'top top', end: '60% top', scrub: true } });

    // Chapter 2: the window assembles from floating glass layers, then four beats.
    const layers = $$('.app .layer:not(.rules)');
    const beats = $$('.app .beat');
    gsap.set(beats.slice(1), { opacity: 0 });
    gsap.set('.app .rules', { opacity: 0, y: 30, scale: 0.95 });
    gsap.set('.app .srv', { opacity: 0, x: -16 });
    const app = gsap.timeline({ defaults: { ease: 'power2.out' }, scrollTrigger: { trigger: '.app', start: 'top top', end: '+=350%', pin: true, scrub } });
    app.from('.app .win', { opacity: 0, scale: 0.9, rotateX: 22, transformPerspective: 1400, duration: 1 })
      .from(layers, {
        opacity: 0, z: (i) => 300 - i * 120, y: (i) => (i - 1.5) * 90, rotateX: 18, transformPerspective: 1000,
        stagger: 0.12, duration: 1,
      }, '<')
      .from(beats[0], { opacity: 0, y: 12, duration: 0.4 }, '<0.6');

    // Beat 1: subscriptions
    app.to('.app .side .sub', { backgroundColor: 'rgba(10,132,255,0.45)', duration: 0.3 })
      .to('.app .srv', { opacity: 1, x: 0, stagger: 0.06, duration: 0.5 }, '<')
      .to({}, { duration: 0.6 });
    // Beat 2: delay test, every server counted up at once
    const ms = $$('.app .ms');
    const count = { v: 0 };
    const showMs = () => ms.forEach((el) => {
      const target = Number(el.dataset.ms);
      el.classList.toggle('ok', count.v > 0 && target > 0);
      el.classList.toggle('bad', count.v >= 1 && !target);
      el.textContent = count.v === 0 ? '—' : target ? `${Math.round(target * count.v)} ms` : count.v >= 1 ? el.dataset.timeout! : '…';
    });
    step(1).to(count, { v: 1, duration: 0.8, ease: 'none', onUpdate: showMs }, '<').to({}, { duration: 0.5 });
    // Beat 3: rules
    step(2).to('.app .rules', { opacity: 1, y: 0, scale: 1, duration: 0.6 }, '<').to({}, { duration: 0.6 });
    // Beat 4: TUN
    step(3).to('.app .knob', { x: 14, duration: 0.4 }, '<')
      .to('.app .toggle', { backgroundColor: '#30d158', duration: 0.4 }, '<')
      .to({}, { duration: 0.8 });

    /** Cross-fade the caption to beat i and return the timeline for chaining. */
    function step(i: number) {
      return app.to(beats[i - 1], { opacity: 0, y: -10, duration: 0.3 })
        .fromTo(beats[i], { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.3 });
    }

    // Chapter 3: the title re-forms, the stage pins while you play with the lens.
    gsap.to(progress, { title: 1, ease: 'none', scrollTrigger: { trigger: '.see', start: 'top bottom', end: 'top top', scrub } });
    const seePin = ScrollTrigger.create({ trigger: '.see', start: 'top top', end: '+=100%', pin: true });
    // The particle title can't scroll with the page, so it fades as soon as the stage unpins.
    gsap.to(progress, { out: 1, ease: 'none', scrollTrigger: { start: () => seePin.end, end: () => seePin.end + innerHeight * 0.08, scrub: true } });

    // ---- The lens follows the pointer; until then it wanders on its own.
    const stream = $('.stream');
    const lens = { x: 0, y: 0 };
    const place = () => { stream.style.setProperty('--x', `${lens.x}px`); stream.style.setProperty('--y', `${lens.y}px`); };
    const followX = gsap.quickTo(lens, 'x', { duration: 0.35, ease: 'power3', onUpdate: place });
    const followY = gsap.quickTo(lens, 'y', { duration: 0.35, ease: 'power3', onUpdate: place });
    lens.x = stream.clientWidth / 2;
    lens.y = stream.clientHeight / 2;
    place();
    const wander = gsap.timeline({ repeat: -1, yoyo: true, defaults: { duration: 2.4, ease: 'sine.inOut', onUpdate: place } })
      .to(lens, { x: () => stream.clientWidth * 0.3, y: () => stream.clientHeight * 0.3 })
      .to(lens, { x: () => stream.clientWidth * 0.7, y: () => stream.clientHeight * 0.7 })
      .to(lens, { x: () => stream.clientWidth * 0.55, y: () => stream.clientHeight * 0.25 });
    if (reducedMotion()) wander.pause();
    stream.addEventListener('pointermove', (e) => {
      wander.kill();
      const r = stream.getBoundingClientRect();
      followX(e.clientX - r.left);
      followY(e.clientY - r.top);
    });

    // ---- Connect: what the lens reads scrambles into what the protocol shows.
    const bar = $('.see .bar');
    const power = $<HTMLButtonElement>('.see .power');
    const status = $('.see .status');
    const line = $('.see .line');
    const what = $('.see .what');
    const chips = $$<HTMLButtonElement>('.see .chip');
    const seen = $$('.see .seen');
    let connected = false;
    let proto = 0;
    let run = 0; // the latest click wins

    const bytes = () => Array.from({ length: 6 }, () => Math.floor(Math.random() * 256).toString(16).padStart(2, '0')).join(' ');
    function scramble() {
      const p = t.see.protocols[proto];
      seen.forEach((el) => gsap.to(el, {
        duration: 0.9,
        delay: Math.random() * 0.3,
        scrambleText: { text: connected ? p.shows || bytes() : el.dataset.real!, chars: '0123456789abcdef.-', speed: 0.6 },
      }));
      what.textContent = connected ? p.what : t.see.off;
    }

    function show(state: 'idle' | 'connecting' | 'connected') {
      bar.dataset.state = state;
      power.setAttribute('aria-pressed', String(state !== 'idle'));
      power.setAttribute('aria-label', state === 'idle' ? t.see.connect : t.see.disconnect);
      status.textContent = state === 'idle' ? t.see.idle
        : state === 'connecting' ? t.see.connecting
        : `${t.see.connected} · ${t.see.delay}`;
    }

    async function connect() {
      const me = ++run;
      show('connecting');
      await new Promise((r) => setTimeout(r, 450));
      if (me !== run) return;
      connected = true;
      show('connected');
      stream.classList.add('connected');
      scramble();
    }

    function disconnect() {
      run++;
      connected = false;
      show('idle');
      stream.classList.remove('connected');
      scramble();
    }

    power.addEventListener('click', () => (connected ? disconnect() : connect()));
    chips.forEach((chip, i) => chip.addEventListener('click', () => {
      proto = i;
      chips.forEach((c, j) => c.setAttribute('aria-pressed', String(i === j)));
      line.textContent = t.see.protocols[i].line;
      if (connected) scramble(); else connect();
    }));

    // ---- Graphics switch
    let stage: Stage | null = null;
    let choice: Choice = savedChoice();
    const choiceButtons = $$<HTMLButtonElement>('[data-choice]');
    function markChoice() {
      for (const b of choiceButtons) {
        const c = b.dataset.choice as Choice;
        b.setAttribute('aria-pressed', String(c === choice));
        if (c === 'auto') b.textContent = stage && choice === 'auto' ? `${t.footer.auto} (${t.footer.presets[stage.preset]})` : t.footer.auto;
      }
    }
    choiceButtons.forEach((b) => b.addEventListener('click', () => {
      choice = b.dataset.choice as Choice;
      saveChoice(choice);
      stage?.setChoice(choice);
      markChoice();
    }));
    markChoice();

    // ---- The 3D loads after the content has painted.
    async function load3D() {
      try {
        const { startScene } = await import('../scene/scene');
        const pinned = (sel: string) => ({ el: $(`${sel} .ptitle`), section: $(sel) });
        stage = await startScene($<HTMLCanvasElement>('#stage'), choice, progress,
          [pinned('.app'), pinned('.see')], { el: $('.app .mb-icon'), section: $('.app') });
        ScrollTrigger.addEventListener('refresh', stage.layout);
        stage.onPreset.add(markChoice);
        markChoice();
        if (new URLSearchParams(location.search).has('fps')) {
          const fps = $('#fps');
          fps.hidden = false;
          setInterval(() => {
            fps.textContent = `${Math.round(stage!.fps)} FPS · ${stage!.preset} · ${stage!.webgpu ? 'WebGPU' : 'WebGL 2'}`;
          }, 500);
        }
      } catch (e) {
        console.warn('3D unavailable, keeping the poster', e);
      }
    }
    const idle = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 1));
    if (document.readyState === 'complete') idle(load3D); else addEventListener('load', () => idle(load3D));
  </script>
</body>
</html>

<style is:global>
  :root {
    --blue: #0a84ff;
    --green: #30d158;
    --red: #ff453a;
    --orange: #ff9f0a;
    --text: #f5f7fb;
    --dim: rgba(235, 240, 255, 0.62);
    --font: -apple-system, BlinkMacSystemFont, 'Geist Variable', system-ui, sans-serif;
    --mono: ui-monospace, 'SF Mono', 'Geist Mono Variable', monospace;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { background: #02050c; }
  body {
    margin: 0;
    font-family: var(--font);
    color: var(--text);
    background: radial-gradient(ellipse at 50% 40%, #0b1a36, #02050c 70%) fixed;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .poster, #stage {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .poster {
    object-fit: contain;
    object-position: 50% 30%;
    height: 70svh;
    margin: auto;
    top: -20svh;
    transition: opacity 0.8s;
  }
  .live .poster { opacity: 0; }
  #stage { opacity: 0; transition: opacity 0.8s; }
  .live #stage { opacity: 1; }

  main, footer { position: relative; }
  .chapter {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    padding: 0 16px 8svh;
    text-align: center;
  }
  .stage {
    height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 5svh 16px 3svh;
    text-align: center;
    overflow: hidden;
  }
  .copy { max-width: 640px; }
  .copy, .stage > p { text-shadow: 0 2px 24px rgba(2, 5, 12, 0.9); }

  h1, h2 { margin: 0; font-weight: 700; letter-spacing: -0.03em; }
  h1 { font-size: clamp(48px, 9vw, 88px); }
  h2 { font-size: clamp(34px, 7vw, 68px); white-space: nowrap; line-height: 1.15; }
  /* With the 3D on, the particles draw the titles; the text stays for search engines and screen readers. */
  .live .ptitle { color: transparent; }
  .tagline { font-size: clamp(20px, 2.6vw, 26px); margin: 8px 0 0; font-weight: 600; }
  .lede { color: var(--dim); font-size: 17px; line-height: 1.5; margin: 12px auto 0; max-width: 34em; }
  .meta { color: var(--dim); font-size: 13px; margin: 14px 0 0; }
  .app h2 { margin-bottom: 3svh; }

  .actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 28px; }
  .button {
    padding: 13px 24px;
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .button.primary { background: var(--blue); border-color: rgba(255, 255, 255, 0.25); box-shadow: 0 8px 32px rgba(10, 132, 255, 0.45); }
  .button:hover { filter: brightness(1.12); }
  .scroll { margin-top: 5svh; color: var(--dim); font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; }

  button:focus-visible, a:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }

  footer {
    padding: 28px 16px 36px;
    color: var(--dim);
    font-size: 13px;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(2, 5, 12, 0.6);
  }
  footer p { margin: 12px 0 0; }
  .graphics { display: flex; gap: 4px; justify-content: center; align-items: center; flex-wrap: wrap; }
  .graphics button {
    font: inherit;
    color: var(--dim);
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 4px 10px;
    cursor: pointer;
  }
  .graphics button[aria-pressed='true'] { color: var(--text); border-color: rgba(255, 255, 255, 0.2); }

  #fps {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 10;
    font: 12px var(--mono);
    background: rgba(0, 0, 0, 0.6);
    padding: 4px 8px;
    border-radius: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>
