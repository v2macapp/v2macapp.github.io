---
import Page from '../layouts/Page.astro';
import Faq from '../components/Faq.astro';
import { faqPage, TEMPLATE_URL, STORE_URL } from '../strings';
import { langOf, strings } from '../i18n';
import { DOWNLOAD_URL, downloadMeta } from '../releases';
const en = await strings(langOf(Astro.url.pathname));
const t = en.sandboxPage;
---
<Page title={t.title} description={t.description} jsonld={[faqPage(t.faq)]} og="/og/sandbox.jpg" earth>
  <header>
    <h1>{t.heading} <span class="badge">{t.beta}</span></h1>
    <p class="lede">{t.lede}</p>
    <div class="actions start"><a class="button primary download" href={DOWNLOAD_URL}>{en.hero.download}</a></div>
    <p class="meta">{downloadMeta}</p>
  </header>

  <section class="panel">
    <h2>{t.get.title}</h2>
    <ol class="grid steps">{t.get.steps.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}</ol>
    <p class="label">{t.get.exitsLabel}</p>
    <ul class="exits">
      {t.get.exits.map((e) => <li><span class={`dot ${e.dot}`}></span><strong>{e.name}</strong><span>{e.state}</span></li>)}
    </ul>
  </section>

  <section class="panel fail">
    <h2>{t.fail.title}</h2>
    <div class="path" aria-hidden="true">
      <div class="wire"><i class="good"></i><b class="packet"></b></div>
      {t.fail.nodes.map((n, i) => <span class={`node n${i}`}>{n}</span>)}
    </div>
    <div class="say"><p class="up">{t.fail.up}</p><p class="down">{t.fail.down}</p></div>
    <p>{t.fail.own}</p>
  </section>

  <section class="panel">
    <h2>{t.inside.title}</h2>
    <div class="grid">
      <div><h3>{t.inside.yesTitle}</h3><ul>{t.inside.yes.map((x) => <li>{x}</li>)}</ul></div>
      <div><h3>{t.inside.noTitle}</h3><ul>{t.inside.no.map((x) => <li>{x}</li>)}</ul></div>
    </div>
  </section>

  <section class="panel">
    <h2>{t.perms.title}</h2>
    <p>{t.perms.lede}</p>
    <ul>{t.perms.items.map((x) => <li>{x}</li>)}</ul>
    <p>{t.perms.ask}</p>
    <p>{t.perms.more}</p>
  </section>

  <section class="panel">
    <h2>{t.keep.title}</h2>
    <div class="grid">{t.keep.items.map(([h, p]) => <div><h3>{h}</h3><p>{p}</p></div>)}</div>
  </section>

  <section class="panel">
    <h2>{t.trust.title}</h2>
    <div class="grid">{t.trust.items.map(([h, p]) => <div><h3>{h}</h3><p>{p}</p></div>)}</div>
  </section>

  <section class="panel">
    <h2>{t.apps.title}</h2>
    <p>{t.apps.text}</p>
    <p><a href={TEMPLATE_URL}>{t.apps.template}</a> · <a href={STORE_URL}>{t.apps.store}</a></p>
  </section>

  <section class="panel">
    <h2>{t.cost.title}</h2>
    <ul>{t.cost.items.map((x) => <li>{x}</li>)}</ul>
    <h3 class="beta">{t.cost.betaTitle}</h3>
    <p>{t.cost.beta}</p>
  </section>

  <section>
    <h2>{t.faqTitle}</h2>
    <Faq items={t.faq} />
  </section>

  <section class="actions start">
    <a class="button primary download" href={DOWNLOAD_URL}>{en.hero.download}</a>
  </section>
</Page>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  // One packet from the app outward; halfway the server dies and it stops at the mini VM.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && innerHeight > 500) {
    gsap.registerPlugin(ScrollTrigger);
    document.documentElement.classList.add('scene');
    const fail = document.querySelector('.fail')!;
    gsap.timeline({ scrollTrigger: { trigger: fail, start: 'center center', end: '+=160%', pin: true, scrub: 0.5 } })
      .set('.fail .packet', { left: '0%', opacity: 1 })
      .to('.fail .packet', { left: '100%', duration: 2, ease: 'none' })
      .set('.fail .packet', { opacity: 0 })
      .set('.fail .packet', { left: '0%' })
      .to('.fail .n2', { color: '#ff453a', borderColor: '#ff453a', duration: 0.3 })
      .to('.fail .good', { width: '33.3%', background: '#ff453a', duration: 0.3 }, '<')
      .to('.fail .up', { opacity: 0, duration: 0.2 }, '<')
      .to('.fail .down', { opacity: 1, duration: 0.3 })
      .set('.fail .packet', { opacity: 1, background: '#ff453a' })
      .to('.fail .packet', { left: '33.3%', duration: 1, ease: 'none' })
      .to({}, { duration: 1 });
  }
</script>
<style>
  .start { justify-content: flex-start; }
  .steps { padding: 0; margin: 0; list-style: none; }
  .label { margin: 24px 0 8px; font-size: 13px; }
  .exits { list-style: none; padding: 0 !important; }
  .exits li { display: flex; gap: 10px; align-items: center; padding: 8px 0; border-top: 1px solid rgba(255, 255, 255, 0.08); margin: 0 !important; flex-wrap: wrap; }
  .exits strong { color: var(--text); margin-inline-end: auto; }
  .dot { width: 9px; height: 9px; border-radius: 50%; }
  .green { background: var(--green); } .red { background: var(--red); } .gray { background: #8e8e93; }
  .beta { margin-top: 20px !important; }
  .path { position: relative; display: flex; justify-content: space-between; margin: 28px 0; }
  .wire { position: absolute; left: 8%; right: 8%; top: 50%; height: 2px; background: rgba(255, 255, 255, 0.2); }
  .good { position: absolute; inset: 0; width: 100%; background: var(--green); }
  .packet { position: absolute; left: 0; top: -5px; width: 12px; height: 12px; margin-left: -6px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 14px var(--blue); opacity: 0; }
  .node { position: relative; padding: 8px 12px; font-size: 14px; font-weight: 600; border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 12px; background: #0c1426; white-space: nowrap; }
  @media (max-width: 480px) { .node { padding: 6px 7px; font-size: 12px; } }
  :global(.scene) .fail .down { opacity: 0; }
  :global(.scene) .say { display: grid; }
  :global(.scene) .say p { grid-area: 1 / 1; }
</style>
