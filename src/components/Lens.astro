---
// Chapter 3's stage: your requests flow past; the lens shows what an observer reads.
// The inside layer repeats the outside one exactly (same lanes, same animation), clipped to the lens.
import { en } from '../strings';
const s = en.see;
const LANES = 5;
const lanes = Array.from({ length: LANES }, (_, i) => {
  const sites = en.sites.map((_, j) => en.sites[(j + i * 5) % en.sites.length]);
  return { sites: [...sites, ...sites], seconds: 34 + ((i * 7) % 4) * 6 }; // twice, for a seamless loop
});
---
<div class="stream" aria-hidden="true">
  <div class="lanes out">
    {lanes.map((l) => (
      <div class="lane"><div class="track" style={`--d:${l.seconds}s`}>
        {l.sites.map((site) => <span class="pkt"><span>{site}</span></span>)}
      </div></div>
    ))}
  </div>
  <div class="inside">
    <div class="lanes">
      {lanes.map((l) => (
        <div class="lane"><div class="track" style={`--d:${l.seconds}s`}>
          {l.sites.map((site) => <span class="pkt"><span class="seen" data-real={site}>{site}</span></span>)}
        </div></div>
      ))}
    </div>
  </div>
  <div class="lens"></div>
</div>

<div class="bar" data-state="idle">
  <button class="power" type="button" aria-label={s.connect} aria-pressed="false">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v8M7.05 6.3a7.5 7.5 0 1 0 9.9 0" /></svg>
  </button>
  <div class="who">
    <strong>{s.server}</strong>
    <span class="line">{s.protocols[0].line}</span>
  </div>
  <div class="status" aria-live="polite">{s.idle}</div>
</div>

<p class="chips-label">{s.protocolsLabel}</p>
<div class="chips" role="group" aria-label={s.protocolsLabel}>
  {s.protocols.map((p, i) => (
    <button class="chip" type="button" data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}>{p.name}</button>
  ))}
</div>
<p class="what" aria-live="polite">{s.off}</p>

<style>
  .stream {
    --x: 50%;
    --y: 50%;
    --r: clamp(64px, 11vw, 96px);
    position: relative;
    width: min(1100px, 100vw);
    flex: 1;
    min-height: 220px;
    max-height: 380px;
    margin-top: 20px;
    overflow: hidden;
    cursor: none;
    touch-action: pan-y;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    text-shadow: none;
  }
  .lanes { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-evenly; }
  .lane { overflow: visible; }
  .track { display: flex; gap: 14px; padding-right: 14px; width: max-content; animation: flow var(--d) linear infinite; }
  @keyframes flow { from { transform: translateX(-50%); } to { transform: translateX(0); } }
  .pkt {
    /* fixed width, so the inside layer lines up with the outside one whatever text the lens shows */
    width: 15em;
    flex: none;
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 8px 12px;
    border-radius: 999px;
    white-space: nowrap;
    font: 13px var(--mono);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .out .pkt span { filter: blur(5px); opacity: 0.55; }

  /* What the observer reads: red while you are exposed, green once V2Mac hides you. */
  .inside { position: absolute; inset: 0; clip-path: circle(var(--r) at var(--x) var(--y)); }
  .inside .lanes { transform: scale(1.12); transform-origin: var(--x) var(--y); }
  .inside .pkt { background: rgba(255, 69, 58, 0.22); border-color: rgba(255, 69, 58, 0.7); color: #ffd6d3; }
  :global(.connected) .inside .pkt { background: rgba(48, 209, 88, 0.18); border-color: rgba(48, 209, 88, 0.6); color: #d4ffe0; }

  .lens {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(var(--r) * 2);
    height: calc(var(--r) * 2);
    translate: -50% -50%;
    border-radius: 50%;
    pointer-events: none;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    box-shadow: inset 0 0 0 6px rgba(255, 255, 255, 0.05), inset 0 0 40px rgba(10, 132, 255, 0.35),
      0 12px 40px rgba(0, 0, 0, 0.55);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 18px auto 0;
    padding: 9px 20px 9px 9px;
    border-radius: 999px;
    width: min(520px, 100%);
    text-align: left;
    background: linear-gradient(180deg, rgba(40, 52, 78, 0.55), rgba(12, 18, 32, 0.6));
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 10px 40px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(24px) saturate(170%);
    -webkit-backdrop-filter: blur(24px) saturate(170%);
  }
  .power {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.08);
    color: var(--dim);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.3s, color 0.3s, box-shadow 0.3s;
  }
  .power svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }
  .power:hover { color: var(--text); }
  .bar:not([data-state='idle']) .power { background: var(--blue); color: #fff; box-shadow: 0 0 24px rgba(10, 132, 255, 0.7); }
  .bar[data-state='connecting'] .power { animation: pulse 0.9s ease-in-out infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 6px rgba(10, 132, 255, 0.4); } }
  .who { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .who strong { font-size: 15px; }
  .line { color: var(--dim); font-size: 12px; font-family: var(--mono); }
  .status { font-size: 14px; color: var(--dim); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .bar[data-state='connected'] .status { color: var(--green); }

  .chips-label { color: var(--dim); font-size: 13px; margin: 18px 0 10px; }
  .chips { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
  .chip {
    color: var(--text);
    font: 600 14px var(--font);
    padding: 9px 16px;
    border-radius: 999px;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .chip[aria-pressed='true'] { background: rgba(10, 132, 255, 0.35); border-color: rgba(10, 132, 255, 0.8); }
  .what { color: var(--dim); font-size: 15px; min-height: 3em; margin: 12px auto 0; max-width: 32em; }

  @media (prefers-reduced-motion: reduce) {
    .track { animation-play-state: paused; }
  }

  /* Phones and short laptop screens: everything stays on the pinned screen; the stream takes what's left. */
  @media (max-width: 800px), (max-height: 720px) {
    .stream { min-height: 90px; margin-top: 8px; }
    .bar { margin-top: 8px; padding: 5px 14px 5px 5px; gap: 10px; }
    .power { width: 38px; height: 38px; }
    .who strong, .line { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .who strong { font-size: 14px; }
    .line { font-size: 11px; }
    .status { font-size: 12px; }
    .chips-label { display: none; }
    .chips { margin-top: 8px; gap: 4px; flex-wrap: nowrap; }
    .chip { font-size: 12px; padding: 6px 9px; white-space: nowrap; }
    .what { font-size: 13px; line-height: 1.35; min-height: 3.6em; margin-top: 8px; }
  }
</style>
