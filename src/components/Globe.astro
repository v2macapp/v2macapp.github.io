---
// Chapter 4's stage: the brush and readout; the globe itself is 3D and sits where `.spot` is.
// index.astro wires the clicks to the scene.
import { en } from '../strings';
const g = en.globe;
const rules = ['proxy', 'direct', 'block'] as const;
---
<div class="world">
  <div class="side">
    <p class="lede">{g.lede}</p>
    <div class="brush" role="group" aria-label={g.brush}>
      {rules.map((r, i) => (
        <button type="button" data-rule={r} aria-pressed={i === 1 ? 'true' : 'false'}>
          <span class={`dot ${r}`}></span><strong>{g.rules[r].name}</strong><small>{g.rules[r].help}</small>
        </button>
      ))}
    </div>
    <p class="picked" aria-live="polite">{g.idle}</p>
    <button type="button" class="reset">{g.reset}</button>
  </div>
  <div class="spot" aria-hidden="true"></div>
</div>

<style>
  .world {
    flex: 1;
    min-height: 0;
    width: min(1280px, 100%);
    display: grid;
    grid-template-columns: minmax(240px, 1fr) 1.6fr;
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    text-align: left;
  }
  .side { display: flex; flex-direction: column; gap: 18px; }
  .side .lede { margin: 0; }
  .brush { display: flex; flex-direction: column; gap: 8px; }
  .brush button {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: baseline;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 14px;
    font: inherit;
    color: var(--text);
    text-align: left;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    cursor: pointer;
  }
  .brush button[aria-pressed='true'] { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.35); }
  .brush small { color: var(--dim); font-size: 13px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; align-self: center; }
  .dot.proxy { background: var(--orange); box-shadow: 0 0 10px var(--orange); }
  .dot.direct { background: var(--green); box-shadow: 0 0 10px var(--green); }
  .dot.block { background: var(--red); box-shadow: 0 0 10px var(--red); }
  .picked { margin: 0; min-height: 1.5em; font-weight: 600; }
  .reset {
    align-self: flex-start;
    font: inherit;
    font-size: 13px;
    color: var(--dim);
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    padding: 5px 12px;
    cursor: pointer;
  }
  .spot { aspect-ratio: 1; max-height: 100%; width: 100%; touch-action: pan-y; cursor: grab; }
  /* Without the 3D there is no globe to paint. */
  :global(html:not(.live)) .brush, :global(html:not(.live)) .picked, :global(html:not(.live)) .reset { display: none; }

  @media (max-width: 800px) {
    .world { grid-template-columns: 1fr; grid-template-rows: auto auto; align-content: center; gap: 12px; }
    .spot { order: -1; width: min(100%, 46svh); justify-self: center; }
    .brush { flex-direction: row; }
    .brush button { grid-template-columns: auto auto; padding: 8px 10px; }
    .brush small { display: none; }
    .side { gap: 10px; }
    .side .lede { font-size: 15px; }
  }
</style>
