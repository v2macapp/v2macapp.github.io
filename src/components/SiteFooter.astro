---
import { REPO_URL } from '../strings';
import { langOf, localize, strings } from '../i18n';
import { docsHome } from '../docs';
const lang = langOf(Astro.url.pathname), t = await strings(lang), l = t.footer.links;
const to = (p: string) => localize(lang, p);
---
<footer>
  <nav class="links" aria-label="Site">
    <a href={to('/sandbox/')}>{l.sandbox}</a>
    <a href={to('/noleaker/')}>{l.noleaker}</a>
    <a href="/blog/">{l.blog}</a>
    <a href={to('/v2rayn-for-mac/')}>{l.v2rayn}</a>
    <a href={to('/v2rayx-alternative/')}>{l.v2rayx}</a>
    <a href={to('/guides/vless-reality-mac/')}>{l.reality}</a>
    <a href={to('/guides/hysteria2-mac/')}>{l.hysteria}</a>
    <a href={docsHome(lang)}>{l.docs}</a>
    <a href={REPO_URL}>{l.source}</a>
  </nav>
  <slot />
  <p>{t.footer.tracking} {t.footer.credit}</p>
</footer>
