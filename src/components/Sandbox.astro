---
// Chapter 4's stage: a draggable row of glass mini VM cards; cut a card's server and it seals.
// index.astro makes the row draggable and wires the Cut buttons.
import { en } from '../strings';
const s = en.sandbox;
---
<p class="badge"><span>{s.beta}</span></p>
<p class="lede">{s.lede}</p>
<div class="rail">
  <div class="cards">
    {s.vms.map((v) => (
      <article class="vm" style={`--hue:${v.hue}`}>
        <div class="win">
          <div class="bar"><i></i><i></i><i></i><span>{v.app} — {v.vm}</span></div>
          <div class="page" aria-hidden="true"><b></b><b></b><b class="short"></b><b></b><b class="short"></b></div>
          <div class="seal" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5z" /></svg>
            {s.sealed}
          </div>
        </div>
        <footer>
          <span class="exit"><span class="flag">{v.flag}</span><span class="city" data-up={`${v.city} · ${v.delay}`}>{v.city} · {v.delay}</span></span>
          <button type="button" class="cut" aria-pressed="false">{s.cut}</button>
        </footer>
      </article>
    ))}
  </div>
</div>
<p class="hint">{s.drag}</p>
<a class="button more" href="/sandbox">{s.more}</a>

<style>
  .badge { margin: 4px 0 0; }
  .badge span {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font: 600 12px var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1a0f00;
    background: var(--orange);
    box-shadow: 0 0 20px rgba(255, 159, 10, 0.5);
  }
  .rail { width: 100vw; overflow: hidden; padding: 28px 0; flex: 1; min-height: 0; display: flex; align-items: center; }
  .cards { display: flex; gap: 24px; padding: 0 max(16px, calc(50vw - 560px)); cursor: grab; }
  .vm {
    --tint: hsl(var(--hue) 90% 60%);
    flex: none;
    width: clamp(240px, 26vw, 320px);
    border-radius: 22px;
    padding: 10px;
    text-align: left;
    /* liquid glass: a tinted frosted pane with a moving sheen */
    background:
      linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.14) var(--sheen, 45%), transparent 60%),
      linear-gradient(160deg, hsl(var(--hue) 80% 55% / 0.22), rgba(255, 255, 255, 0.04));
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .win { position: relative; border-radius: 14px; overflow: hidden; background: rgba(8, 12, 22, 0.8); }
  .bar { display: flex; align-items: center; gap: 6px; padding: 9px 10px; font-size: 12px; color: var(--dim); }
  .bar i { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); }
  .bar i:first-child { background: #ff5f57; }
  .bar span { margin-left: 6px; color: var(--text); font-weight: 600; white-space: nowrap; }
  .page { display: grid; gap: 8px; padding: 12px 14px 18px; }
  .page b {
    height: 10px;
    border-radius: 5px;
    background: linear-gradient(90deg, hsl(var(--hue) 70% 50% / 0.35), hsl(var(--hue) 90% 70% / 0.7), hsl(var(--hue) 70% 50% / 0.35));
    background-size: 200% 100%;
    animation: live 2.4s linear infinite; /* the app is running */
  }
  .page b:first-child { height: 46px; border-radius: 8px; }
  .page b.short { width: 60%; }
  @keyframes live { to { background-position: -200% 0; } }
  .seal {
    position: absolute;
    inset: 34px 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #ffd7d4;
    background: rgba(60, 8, 8, 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    transition: opacity 0.35s;
  }
  .seal svg { width: 26px; height: 26px; fill: none; stroke: var(--red); stroke-width: 2; }
  footer { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 4px 2px; font-size: 13px; }
  .exit { display: flex; align-items: center; gap: 6px; min-width: 0; white-space: nowrap; }
  .city { color: var(--green); font-family: var(--mono); font-size: 12px; overflow: hidden; text-overflow: ellipsis; }
  .cut {
    flex: none;
    font: inherit;
    font-size: 12px;
    color: var(--text);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    padding: 5px 10px;
    cursor: pointer;
  }
  .vm.sealed { border-color: rgba(255, 69, 58, 0.7); box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45), 0 0 0 1px var(--red), 0 0 40px rgba(255, 69, 58, 0.35); }
  .vm.sealed .seal { opacity: 1; }
  .vm.sealed .page b { animation-play-state: paused; filter: grayscale(1) brightness(0.6); }
  .vm.sealed .city { color: var(--red); }
  .hint { color: var(--dim); font-size: 13px; margin: 0 0 14px; }
  .more { margin-bottom: 2svh; }
</style>
