---
// Chapter 2's stage: the V2Mac window rebuilt in HTML from the app's main window (demo data only).
// index.astro's timeline assembles its .layer parts and plays the four beats.
import { en, servers } from '../strings';
const t = en.app;
const s = en.see;
---
<div class="desk" aria-hidden="true">
  <div class="menubar">
    <b>V2Mac</b>
    {t.menu.map((m) => <span class="menu">{m}</span>)}
    <span class="grow"></span>
    <span class="mb-icon">
      <svg viewBox="0 0 24 24"><path d="M5 5l7 14 7-14" /></svg>
    </span>
    <span>9:41</span>
  </div>

  <div class="win">
    <div class="layer side">
      <div class="row on">{t.sidebar.all}<i>11</i></div>
      <div class="row">{t.sidebar.favorites}<i>3</i></div>
      <div class="row">{t.sidebar.custom}</div>
      <div class="head">{t.sidebar.subscriptions}</div>
      <div class="row sub">Example Cloud<i>8</i></div>
      <div class="row">Demo VPN<i>3</i></div>
    </div>

    <div class="layer list">
      <div class="cols">{t.columns.map((c) => <span>{c}</span>)}</div>
      {servers.map((v, i) => (
        <div class:list={['srv', { on: i === 0 }]}>
          <span class="name">{v.flag} {v.name}</span>
          <span class="type">{v.type}</span>
          <span class="ms" data-ms={v.ms} data-timeout={t.timeout}>—</span>
          <span class="speed">{v.speed}</span>
        </div>
      ))}
    </div>

    <div class="layer insp">
      <strong>🇩🇪 {servers[0].name}</strong>
      <span class="type">{servers[0].type}</span>
      <span class="btn">{t.connect}</span>
      <dl>
        <dt>Protocol</dt><dd>vless</dd>
        <dt>Transport</dt><dd>raw</dd>
        <dt>Security</dt><dd>reality</dd>
        <dt>Address</dt><dd>node00.example.com</dd>
      </dl>
    </div>

    <div class="layer cbar">
      <span class="pwr"><svg viewBox="0 0 24 24"><path d="M12 3v8M7.05 6.3a7.5 7.5 0 1 0 9.9 0" /></svg></span>
      <span class="who"><strong>{servers[0].name}</strong><em>{t.connected} · {s.delay}</em></span>
      <span class="grow"></span>
      <span class="tun">{t.tun}<span class="toggle"><span class="knob"></span></span></span>
      <span class="mode">{t.mode}</span>
    </div>

    <div class="layer rules">
      <strong>{t.rules.title}</strong>
      {t.rules.items.map((r) => (
        <div class="rule"><span>{r.what}</span><span class:list={['pill', r.action.toLowerCase()]}>{r.action}</span></div>
      ))}
    </div>
  </div>
</div>
<div class="beats">
  {t.beats.map((b) => <p class="beat">{b}</p>)}
</div>

<style>
  .desk {
    width: min(1040px, 100%);
    flex: 1;
    min-height: 0;
    max-height: 600px;
    display: flex;
    flex-direction: column;
    perspective: 1400px;
    font-size: 13px;
    text-shadow: none;
  }
  .menubar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 28px;
    padding: 0 14px;
    border-radius: 10px;
    background: rgba(20, 26, 40, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    margin-bottom: 14px;
    font-size: 13px;
  }
  .menu { color: var(--dim); }
  .grow { flex: 1; }
  .mb-icon { width: 18px; height: 18px; display: grid; place-items: center; }
  .mb-icon svg { width: 18px; height: 18px; fill: none; stroke: #fff; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }

  .win {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 180px 1fr 220px;
    grid-template-rows: 1fr auto;
    gap: 10px;
    padding: 10px;
    border-radius: 22px;
    background: rgba(24, 28, 40, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 30px 80px rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(30px) saturate(160%);
    -webkit-backdrop-filter: blur(30px) saturate(160%);
    transform-style: preserve-3d;
    position: relative;
    text-align: left;
  }
  .layer {
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    padding: 10px;
    min-height: 0;
    overflow: hidden;
  }
  .side { grid-row: 1 / 3; display: flex; flex-direction: column; gap: 2px; }
  .side .row { display: flex; justify-content: space-between; padding: 6px 8px; border-radius: 8px; }
  .side .row.on { background: rgba(255, 255, 255, 0.08); }
  .side i { font-style: normal; color: var(--dim); font-size: 11px; }
  .side .head { color: var(--dim); font-size: 11px; margin: 12px 8px 4px; }

  .list { display: flex; flex-direction: column; gap: 3px; }
  .cols, .srv { display: grid; grid-template-columns: 1.3fr 1.3fr 0.8fr 0.8fr; gap: 8px; padding: 5px 10px; border-radius: 8px; }
  .cols { color: var(--dim); font-size: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.07); border-radius: 0; }
  .srv { background: rgba(255, 255, 255, 0.03); }
  .srv.on { background: rgba(10, 132, 255, 0.85); }
  .type { color: var(--dim); font-family: var(--mono); font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .srv.on .type { color: rgba(255, 255, 255, 0.8); }
  .ms { font-variant-numeric: tabular-nums; color: var(--dim); }
  .ms.ok { color: var(--green); }
  .ms.bad { color: var(--orange); }
  .srv.on .ms.ok { color: #b6ffc8; }

  .insp { display: flex; flex-direction: column; gap: 6px; }
  .insp strong { font-size: 15px; }
  .btn { align-self: center; margin: 8px 0; padding: 5px 18px; border-radius: 8px; background: var(--blue); font-weight: 600; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 8px 10px; margin: 6px 0 0; }
  dt { color: var(--text); }
  dd { margin: 0; color: var(--dim); text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .cbar { grid-column: 2; display: flex; align-items: center; gap: 12px; border-radius: 999px; padding: 6px 16px 6px 6px; }
  .pwr { width: 34px; height: 34px; border-radius: 50%; background: var(--blue); display: grid; place-items: center; box-shadow: 0 0 18px rgba(10, 132, 255, 0.6); }
  .pwr svg { width: 17px; height: 17px; fill: none; stroke: #fff; stroke-width: 2.4; stroke-linecap: round; }
  .who { display: flex; flex-direction: column; }
  .who em { font-style: normal; color: var(--green); font-size: 11px; }
  .tun { display: flex; align-items: center; gap: 8px; color: var(--dim); font-size: 12px; }
  .toggle { width: 34px; height: 20px; border-radius: 999px; background: rgba(255, 255, 255, 0.18); position: relative; }
  .knob { position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fff; }
  .mode { color: var(--dim); }

  .rules {
    position: absolute;
    right: 250px;
    bottom: 76px;
    width: 250px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px;
    background: rgba(40, 46, 62, 0.92);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }
  .rule { display: flex; justify-content: space-between; align-items: center; }
  .pill { padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; color: #000; }
  .pill.proxy { background: var(--orange); }
  .pill.direct { background: var(--green); }
  .pill.block { background: var(--red); }

  .beats { position: relative; height: 3.2em; width: min(560px, 100%); margin-top: 18px; }
  .beat { position: absolute; inset: 0; margin: 0; color: var(--dim); font-size: 17px; line-height: 1.45; }

  @media (max-width: 760px) {
    .win { grid-template-columns: 1fr; }
    .side, .insp, .menu { display: none; }
    .cbar { grid-column: 1; }
    .cols, .srv { grid-template-columns: 1.6fr 0.8fr; }
    .cols span:nth-child(2n), .srv .type, .srv .speed { display: none; }
    .mode { display: none; }
    .rules { right: 12px; bottom: 70px; width: min(250px, calc(100% - 24px)); }
  }
</style>
