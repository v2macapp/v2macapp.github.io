---
// Every page's shell: head with its SEO, the shared styles, and the phone's Send to my Mac.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import { en as t } from '../strings';
const { title, description, jsonld = [], og = '/og/home.jpg', ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(og, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/app/icon.webp" type="image/webp" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="V2Mac" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  {jsonld.map((d) => <script is:inline type="application/ld+json" set:html={JSON.stringify(d).replace(/</g, '\\u003c')} />)}
</head>
<body data-send={t.send.label} data-copied={t.send.copied} data-title={t.send.title}>
  <slot />
  <script>
    // Phones can't run V2Mac: the download becomes a way to send the link to the Mac.
    if (matchMedia('(hover: none) and (pointer: coarse)').matches) {
      const { send, copied, title } = document.body.dataset;
      for (const a of document.querySelectorAll<HTMLAnchorElement>('a.download')) {
        a.textContent = send!;
        a.addEventListener('click', async (e) => {
          e.preventDefault();
          const url = location.origin + '/';
          if (navigator.share) { await navigator.share({ title, url }).catch(() => {}); return; } // cancelling is fine
          await navigator.clipboard?.writeText(url);
          a.textContent = copied!;
        });
      }
    }
  </script>
</body>
</html>

<style is:global>
  :root {
    --blue: #0a84ff;
    --green: #30d158;
    --red: #ff453a;
    --orange: #ff9f0a;
    --text: #f5f7fb;
    --dim: rgba(235, 240, 255, 0.62);
    --font: -apple-system, BlinkMacSystemFont, 'Geist Variable', system-ui, sans-serif;
    --mono: ui-monospace, 'SF Mono', 'Geist Mono Variable', monospace;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { background: #02050c; }
  body {
    margin: 0;
    font-family: var(--font);
    color: var(--text);
    background: radial-gradient(ellipse at 50% 40%, #0b1a36, #02050c 70%) fixed;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .poster, #stage {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .poster {
    object-fit: contain;
    object-position: 50% 30%;
    height: 70svh;
    margin: auto;
    top: -20svh;
    transition: opacity 0.8s;
  }
  .live .poster { opacity: 0; }
  .live .hero { cursor: grab; } /* the V can be thrown */
  .grabbing, .grabbing * { cursor: grabbing !important; user-select: none; }
  #stage { opacity: 0; transition: opacity 0.8s; }
  .live #stage { opacity: 1; }

  main, footer { position: relative; }
  .chapter {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    padding: 0 16px 8svh;
    text-align: center;
  }
  .stage {
    height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 5svh 16px 3svh;
    text-align: center;
    overflow: hidden;
  }
  .copy { max-width: 640px; }
  .copy, .stage > p { text-shadow: 0 2px 24px rgba(2, 5, 12, 0.9); }

  h1, h2 { margin: 0; font-weight: 700; letter-spacing: -0.03em; }
  h1 { font-size: clamp(48px, 9vw, 88px); }
  h2 { font-size: clamp(34px, 7vw, 68px); white-space: nowrap; line-height: 1.15; }
  /* With the 3D on, the particles draw the titles; the text stays for search engines and screen readers. */
  .live .ptitle { color: transparent; }
  .tagline { font-size: clamp(20px, 2.6vw, 26px); margin: 8px 0 0; font-weight: 600; }
  .lede { color: var(--dim); font-size: 17px; line-height: 1.5; margin: 12px auto 0; max-width: 34em; }
  .meta { color: var(--dim); font-size: 13px; margin: 14px 0 0; }
  .app h2 { margin-bottom: 3svh; }

  .actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 28px; }
  .button {
    padding: 13px 24px;
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .button.primary { background: var(--blue); border-color: rgba(255, 255, 255, 0.25); box-shadow: 0 8px 32px rgba(10, 132, 255, 0.45); }
  .button:hover { filter: brightness(1.12); }
  .scroll { margin-top: 5svh; color: var(--dim); font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; }

  button:focus-visible, a:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }

  footer {
    padding: 28px 16px 36px;
    color: var(--dim);
    font-size: 13px;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(2, 5, 12, 0.6);
  }
  footer p { margin: 12px 0 0; }
  .links { display: flex; gap: 6px 16px; justify-content: center; flex-wrap: wrap; margin-bottom: 14px; }
  .links a { color: var(--dim); }
  .after { max-width: 760px; margin: 0 auto; padding: 12svh 16px; }
  .after .faq { background: rgba(10, 16, 30, 0.62); border: 1px solid rgba(255, 255, 255, 0.11); border-radius: 22px; padding: 8px 22px; backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px); }
  .after h2 { white-space: normal; text-align: center; margin-bottom: 28px; }
  .nl { text-align: center; padding-top: 0; }
  a { color: #5eb0ff; }
  code { font-family: var(--mono); font-size: 0.92em; background: rgba(255,255,255,.08); padding: 1px 5px; border-radius: 5px; overflow-wrap: anywhere; }
  pre { overflow-x: auto; background: rgba(0,0,0,.4); padding: 12px 14px; border-radius: 10px; }
  pre code { background: none; padding: 0; overflow-wrap: normal; }
  .graphics { display: flex; gap: 4px; justify-content: center; align-items: center; flex-wrap: wrap; }
  .graphics button {
    font: inherit;
    color: var(--dim);
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 4px 10px;
    cursor: pointer;
  }
  .graphics button[aria-pressed='true'] { color: var(--text); border-color: rgba(255, 255, 255, 0.2); }

  #fps {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 10;
    font: 12px var(--mono);
    background: rgba(0, 0, 0, 0.6);
    padding: 4px 8px;
    border-radius: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
</style>
