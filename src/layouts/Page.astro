---
// Every page but the main one: top links, content, footer; `earth` adds the turning Earth behind it.
import Base from './Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LangLinks from '../components/LangLinks.astro';
import { langOf, localize, strings } from '../i18n';
import { docsHome } from '../docs';
const { earth = false, ...head } = Astro.props;
const lang = langOf(Astro.url.pathname), t = await strings(lang);
---
<Base {...head}>
  {earth && <canvas id="stage" aria-hidden="true"></canvas>}
  <header class="top">
    <a class="brand" href={localize(lang, '/')}><img src="/app/icon.webp" alt="" width="24" height="24" />{t.nav.home}</a>
    <nav aria-label="Main">
      <a href={localize(lang, '/sandbox/')}>{t.nav.sandbox}</a>
      <a href={localize(lang, '/noleaker/')}>{t.nav.noleaker}</a>
      <a href="/blog/">{t.nav.blog}</a>
      <a href={docsHome(lang)}>{t.footer.links.docs}</a>
    </nav>
    <LangLinks />
  </header>
  <main class="page"><slot /></main>
  <SiteFooter />
  {earth && <script>
    import { startBackdrop } from '../scene/backdrop';
    const idle = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 1));
    const run = () => idle(() => startBackdrop(document.querySelector<HTMLCanvasElement>('#stage')!).catch((e) => console.warn('3D unavailable', e)));
    if (document.readyState === 'complete') run(); else addEventListener('load', run);
  </script>}
</Base>
<style is:global>
  .top { position: relative; display: flex; justify-content: space-between; align-items: center; gap: 12px; max-width: 1040px; margin: 0 auto; padding: 16px; flex-wrap: wrap; }
  .top a { color: var(--dim); text-decoration: none; font-size: 14px; }
  .top a:hover { color: var(--text); }
  .top .brand { display: flex; align-items: center; gap: 8px; color: var(--text); font-weight: 600; font-size: 16px; }
  .top nav { display: flex; gap: 16px; }
  .page { max-width: 880px; margin: 0 auto; padding: 5svh 16px 10svh; line-height: 1.6; }
  .page h1 { font-size: clamp(38px, 7vw, 64px); line-height: 1.08; }
  .page > header .lede { margin-inline-start: 0; font-size: 19px; max-width: 38em; }
  .page h2 { font-size: clamp(26px, 4vw, 36px); line-height: 1.15; white-space: normal; margin: 0 0 14px; letter-spacing: -0.02em; }
  .page h3 { margin: 0 0 4px; font-size: 17px; }
  .page section { margin-top: 28px; }
  .panel { background: rgba(10, 16, 30, 0.8); border: 1px solid rgba(255, 255, 255, 0.11); border-radius: 22px; padding: clamp(18px, 3vw, 30px); backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px); }
  .panel p, .panel li { color: var(--dim); }
  .panel ul, .panel ol { margin: 0; padding-inline-start: 20px; }
  .panel li + li { margin-top: 6px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 18px; }
  .grid p { margin: 0; }
  .badge { display: inline-block; vertical-align: middle; font-size: 13px; font-weight: 700; color: #1a0f00; background: var(--orange); padding: 3px 9px; border-radius: 999px; letter-spacing: 0; }
  table { width: 100%; border-collapse: collapse; font-size: 15px; }
  th, td { text-align: start; padding-block: 10px; padding-inline: 0 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); vertical-align: top; }
  td { color: var(--dim); }
  td:first-child { color: var(--text); font-weight: 600; }
</style>
